   }
 }
 
+/* HARMONY: per-second PRB ground truth for every UE (capped or not), independent of
+ * the KPM counters: tx_rb = PRBs actually transmitted (sum of rbSize at MAC PDU
+ * generation), budget = sum of DL BWP PRBs over DL slots (KPM's denominator). */
+static struct {
+  uint16_t rnti;
+  uint64_t tx;
+  uint32_t tbs;
+} g_all[AURA_MAX_UES];
+static int g_all_n;
+static uint64_t g_all_budget;
+
+static void aq_all_flush(void);
+
+void aura_quota_note_dl_slot(int bw)
+{
+  static struct timespec last;
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  if (now.tv_sec != last.tv_sec) {
+    if (last.tv_sec != 0)
+      aq_all_flush(); /* same interval for tx_rb and budget */
+    last = now;
+  }
+  if (bw > 0)
+    g_all_budget += (uint64_t)bw;
+}
+
+static void aq_all_note(uint16_t rnti, uint16_t rbSize)
+{
+  int i = 0;
+  while (i < g_all_n && g_all[i].rnti != rnti)
+    i++;
+  if (i == g_all_n) {
+    if (g_all_n >= AURA_MAX_UES)
+      return;
+    g_all[g_all_n].rnti = rnti;
+    g_all[g_all_n].tx = 0;
+    g_all[g_all_n].tbs = 0;
+    g_all_n++;
+  }
+  g_all[i].tx += rbSize;
+  g_all[i].tbs++;
+}
+
+static void aq_all_flush(void)
+{
+  uint64_t any = 0;
+  for (int i = 0; i < g_all_n; i++)
+    any |= g_all[i].tx;
+  if (any) {
+    char line[512];
+    int o = snprintf(line, sizeof(line), "[AURA-PRB] 1s budget=%llu", (unsigned long long)g_all_budget);
+    for (int i = 0; i < g_all_n && o < (int)sizeof(line) - 64; i++)
+      o += snprintf(line + o, sizeof(line) - o, " rnti=0x%04x:slice=%d:tx_rb=%llu:tbs=%u", g_all[i].rnti,
+                    aq_ue_slice(g_all[i].rnti), (unsigned long long)g_all[i].tx, g_all[i].tbs);
+    fprintf(stderr, "%s\n", line);
+  }
+  g_all_n = 0; /* forget UEs that left; re-learned on their next TB */
+  g_all_budget = 0;
+}
+
 void aura_quota_begin_slot(uint16_t frame, uint16_t slot)
 {
   (void)frame;
@@ -434,6 +495,7 @@ void aura_quota_begin_slot(uint16_t frame, uint16_t slot)
 
 void aura_quota_note_tx(uint16_t rnti, uint16_t rbSize)
 {
+  aq_all_note(rnti, rbSize);
   for (int i = 0; i < g_aq.n_ues; i++)
     if (g_aq.ues[i].rnti == rnti)
       g_aq.ues[i].tx += rbSize;
