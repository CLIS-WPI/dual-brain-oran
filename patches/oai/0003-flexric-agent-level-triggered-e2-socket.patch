+// HARMONY: level-triggered registration for the E2 SCTP socket. event_asio_agent()
+// returns one fd per call (maxevents = 1) and the loop reads one SCTP message per
+// event; with EPOLLET a message that arrived together with another one (e.g. a
+// subscription request followed by a control) never gets its own edge and stays
+// queued until the next arrival, so every later message is handled one behind.
+void add_fd_level_asio_agent(asio_agent_t* io, int fd)
+{
+  assert(io != NULL);
+  const int op = EPOLL_CTL_ADD;
+  const epoll_data_t e_data = {.fd = fd};
+  const int e_events = EPOLLIN; // level triggered: epoll keeps reporting the fd while data is queued
+  struct epoll_event event = {.events = e_events, .data = e_data};
+  int rc = epoll_ctl(io->efd, op, fd, &event);
+  assert(rc != -1);
+}
+
 void rm_fd_asio_agent(asio_agent_t* io, int fd)
 {
   assert(io != NULL);
