+/* ---- Harmony: E2 SLICE SM → AURA --------------------------------------- */
+
+typedef struct {
+  int id;
+  int pct;
+} aura_e2_slice_t;
+
+typedef struct {
+  uint32_t ue_ref;
+  int slice_id;
+} aura_e2_ue_t;
+
+static struct {
+  pthread_mutex_t mtx;
+  int n_slices;
+  int n_ues;
+  aura_e2_slice_t slices[AURA_MAX_SLICES];
+  aura_e2_ue_t ues[AURA_MAX_UES];
+  uint64_t version;
+} g_e2 = {.mtx = PTHREAD_MUTEX_INITIALIZER};
+
+static uint64_t g_e2_applied_version;
+static int g_e2_mode; /* 1 while E2 slices exist: file is ignored */
+
+void aura_quota_e2_add_slice(int slice_id, int pct)
+{
+  if (pct < 1)
+    pct = 1;
+  if (pct > 100)
+    pct = 100;
+  pthread_mutex_lock(&g_e2.mtx);
+  int i = 0;
+  while (i < g_e2.n_slices && g_e2.slices[i].id != slice_id)
+    i++;
+  if (i == g_e2.n_slices && g_e2.n_slices < AURA_MAX_SLICES)
+    g_e2.n_slices++;
+  if (i < g_e2.n_slices) {
+    g_e2.slices[i].id = slice_id;
+    g_e2.slices[i].pct = pct;
+    g_e2.version++;
+  }
+  pthread_mutex_unlock(&g_e2.mtx);
+  fprintf(stderr, "[AURA-QUOTA] E2 slice add/mod id=%d pct=%d\n", slice_id, pct);
+}
+
+void aura_quota_e2_del_slice(int slice_id)
+{
+  pthread_mutex_lock(&g_e2.mtx);
+  for (int i = 0; i < g_e2.n_slices; i++) {
+    if (g_e2.slices[i].id == slice_id) {
+      g_e2.slices[i] = g_e2.slices[--g_e2.n_slices];
+      break;
+    }
+  }
+  for (int i = 0; i < g_e2.n_ues;) {
+    if (g_e2.ues[i].slice_id == slice_id)
+      g_e2.ues[i] = g_e2.ues[--g_e2.n_ues];
+    else
+      i++;
+  }
+  g_e2.version++;
+  pthread_mutex_unlock(&g_e2.mtx);
+  fprintf(stderr, "[AURA-QUOTA] E2 slice del id=%d\n", slice_id);
+}
+
+void aura_quota_e2_assoc(uint32_t ue_ref, int slice_id)
+{
+  pthread_mutex_lock(&g_e2.mtx);
+  int i = 0;
+  while (i < g_e2.n_ues && g_e2.ues[i].ue_ref != ue_ref)
+    i++;
+  if (i == g_e2.n_ues && g_e2.n_ues < AURA_MAX_UES)
+    g_e2.n_ues++;
+  if (i < g_e2.n_ues) {
+    g_e2.ues[i].ue_ref = ue_ref;
+    g_e2.ues[i].slice_id = slice_id;
+    g_e2.version++;
+  }
+  pthread_mutex_unlock(&g_e2.mtx);
+  fprintf(stderr, "[AURA-QUOTA] E2 ue assoc ue_ref=%u -> slice %d\n", ue_ref, slice_id);
+}
+
+/* RNTI of a connected UE given an RNTI or a RAN UE ID (= gNB-CU UE ID). Called
+ * with the MAC scheduler lock held (from the DL scheduler). */
+static int aq_resolve_rnti(uint32_t ue_ref, uint16_t *bwp_size)
+{
+  gNB_MAC_INST *mac = RC.nrmac ? RC.nrmac[0] : NULL;
+  if (!mac)
+    return -1;
+  int found = -1;
+  UE_iterator (mac->UE_info.connected_ue_list, UE) {
+    if (*bwp_size == 0)
+      *bwp_size = UE->current_DL_BWP.BWPSize;
+    if (UE->rnti == ue_ref) {
+      found = UE->rnti;
+      break;
+    }
+    if (du_exists_f1_ue_data(UE->rnti) && du_get_f1_ue_data(UE->rnti).secondary_ue == ue_ref) {
+      found = UE->rnti;
+      break;
+    }
+  }
+  return found;
+}
+
+/* Returns 1 while E2 mode owns the tables (file ignored). */
+static int aq_e2_apply(void)
+{
+  pthread_mutex_lock(&g_e2.mtx);
+  if (g_e2.n_slices == 0) {
+    if (g_e2_mode) {
+      fprintf(stderr, "[AURA-QUOTA] E2 slices removed, quota off (file mode if present)\n");
+      memset(&g_aq, 0, sizeof(g_aq));
+      g_e2_mode = 0;
+    }
+    g_e2_applied_version = g_e2.version;
+    pthread_mutex_unlock(&g_e2.mtx);
+    return 0;
+  }
+  /* Re-resolve on change and every 200 slots (RNTI changes on re-attach). */
+  int changed = g_e2.version != g_e2_applied_version;
+  if (!changed && g_e2_mode && (g_aq.slot_count % 200) != 0) {
+    pthread_mutex_unlock(&g_e2.mtx);
+    return 1;
+  }
+  uint64_t slots = g_aq.slot_count;
+  aura_ue_t prev[AURA_MAX_UES];
+  int n_prev = g_aq.n_ues;
+  memcpy(prev, g_aq.ues, sizeof(prev));
+  memset(&g_aq, 0, sizeof(g_aq));
+  g_aq.slot_count = slots;
+  uint16_t bwp = 0;
+  for (int i = 0; i < g_e2.n_ues && g_aq.n_ues < AURA_MAX_UES; i++) {
+    int rnti = aq_resolve_rnti(g_e2.ues[i].ue_ref, &bwp);
+    if (rnti < 0)
+      continue;
+    g_aq.ues[g_aq.n_ues].rnti = (uint16_t)rnti;
+    g_aq.ues[g_aq.n_ues].slice_id = g_e2.ues[i].slice_id;
+    for (int k = 0; k < n_prev; k++) /* keep diagnostics counters across re-resolve */
+      if (prev[k].rnti == (uint16_t)rnti) {
+        g_aq.ues[g_aq.n_ues].asked = prev[k].asked;
+        g_aq.ues[g_aq.n_ues].granted = prev[k].granted;
+        g_aq.ues[g_aq.n_ues].tx = prev[k].tx;
+      }
+    g_aq.n_ues++;
+  }
+  if (bwp == 0)
+    aq_resolve_rnti(UINT32_MAX, &bwp);
+  g_aq.cap_C = bwp;
+  for (int i = 0; i < g_e2.n_slices; i++) {
+    int q = (g_e2.slices[i].pct * bwp) / 100;
+    g_aq.slices[i].id = g_e2.slices[i].id;
+    g_aq.slices[i].quota = q > 0 ? q : 1;
+  }
+  g_aq.n_slices = g_e2.n_slices;
+  g_aq.loaded = (g_aq.n_slices > 0 && g_aq.n_ues > 0 && bwp > 0);
+  g_e2_mode = 1;
+  g_e2_applied_version = g_e2.version;
+  pthread_mutex_unlock(&g_e2.mtx);
+
+  if (changed) {
+    fprintf(stderr, "[AURA-QUOTA] E2 applied slices=%d ues=%d/%d bwp=%u active=%d\n",
+            g_aq.n_slices, g_aq.n_ues, g_e2.n_ues, (unsigned)bwp, g_aq.loaded);
+    for (int i = 0; i < g_aq.n_slices; i++)
+      fprintf(stderr, "[AURA-QUOTA]  slice id=%d quota=%d PRB\n", g_aq.slices[i].id, g_aq.slices[i].quota);
+    for (int i = 0; i < g_aq.n_ues; i++)
+      fprintf(stderr, "[AURA-QUOTA]  ue rnti=0x%04x -> slice %d\n", g_aq.ues[i].rnti, g_aq.ues[i].slice_id);
+  }
+  return 1;
+}
