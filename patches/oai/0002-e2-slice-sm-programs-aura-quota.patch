+/*
+ * Harmony: E2 (FlexRIC SLICE SM) programming of the same quota tables.
+ * Called from the E2 agent thread; applied by the MAC scheduler on its next
+ * aura_quota_maybe_reload(). While at least one E2 slice exists it takes
+ * precedence over the JSON file; deleting every E2 slice falls back to the file
+ * (and with no file, to the stock scheduler — default behaviour unchanged).
+ *
+ *  pct      share of the DL BWP in percent (1..100), converted to PRBs in the gNB
+ *  ue_ref   RNTI of a connected UE, or its RAN UE ID as reported by E2SM-KPM
+ *           (gNB-CU UE ID = RRC UE ID); re-resolved periodically so a re-attach
+ *           (new RNTI) keeps its slice.
+ */
+void aura_quota_e2_add_slice(int slice_id, int pct);
+void aura_quota_e2_del_slice(int slice_id);
+void aura_quota_e2_assoc(uint32_t ue_ref, int slice_id);
+
+/** Diagnostics: record PRBs actually transmitted (new tx) for an RNTI; a
+ * per-second "[AURA-QUOTA] 1s" summary (asked / granted / tx per mapped UE) is
+ * printed while a quota is active. */
+void aura_quota_note_tx(uint16_t rnti, uint16_t rbSize);
+
 #endif /* AURA_QUOTA_H */
