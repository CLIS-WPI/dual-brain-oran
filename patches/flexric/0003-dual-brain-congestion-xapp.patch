+                        mode="fast++", cpus=8, holdout_frac=0.2, seed=11, positive_label="1", timeout_s=1800)
+print(json.dumps({k: r[k] for k in ("algorithm", "accuracy", "f1", "inference_latency_ms", "n_holdout")}))
