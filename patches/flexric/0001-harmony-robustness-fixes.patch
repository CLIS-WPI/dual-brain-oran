diff --git a/src/agent/e2_agent.c b/src/agent/e2_agent.c
index 74a684b..179688c 100644
--- a/src/agent/e2_agent.c
+++ b/src/agent/e2_agent.c
@@ -238,15 +238,19 @@ bool pend_event(e2_agent_t* ag, int fd, pending_event_t** p_ev)
   assert(ag != NULL);
   assert(fd > 0);
   assert(*p_ev == NULL);
-  
-  assert(bi_map_size(&ag->pending) == 1 );
+
+  /* HARMONY_PATCH (2026-07-08): return false when no pending event matches fd
+   * instead of asserting — avoids gNB abort on race between SCTP and timer fds. */
+  if (bi_map_size(&ag->pending) == 0)
+    return false;
 
   void* start_it = assoc_front(&ag->pending.left);
   void* end_it = assoc_end(&ag->pending.left);
 
   void* it = find_if(&ag->pending.left,start_it, end_it, &fd, eq_fd);
 
-  assert(it != end_it);
+  if (it == end_it)
+    return false;
   *p_ev = assoc_value(&ag->pending.left ,it);
   return *p_ev != NULL;
 }
