diff --git a/src/sm/pdcp_sm/ie/pdcp_data_ie.c b/src/sm/pdcp_sm/ie/pdcp_data_ie.c
index afb7a28..5a47521 100644
--- a/src/sm/pdcp_sm/ie/pdcp_data_ie.c
+++ b/src/sm/pdcp_sm/ie/pdcp_data_ie.c
@@ -23,6 +23,7 @@
 #include "pdcp_data_ie.h"
 
 #include <assert.h>
+#include <stdio.h>  /* HARMONY_PATCH: stderr warning in check_pdcp_bearer */
 #include <stdlib.h>
 #include <string.h>
 
@@ -146,11 +147,25 @@ bool check_pdcp_bearer(pdcp_radio_bearer_stats_t* rb)
 {
   assert(rb != NULL);
 
-  // Pkts need to be less than bytes since a packet can only have [1,MTU+header)  
-  assert(rb->txpdu_pkts <= rb->txpdu_bytes); 
-  assert(rb->rxpdu_pkts <= rb->rxpdu_bytes);
-  assert(rb->txsdu_pkts <= rb->txsdu_bytes);
-  assert(rb->rxsdu_pkts <= rb->rxsdu_bytes);
+  /* HARMONY_PATCH (2026-07-08, WPI Tang Lab):
+   * Upstream asserts pkts <= bytes and aborts gNB on transient counter races.
+   * Clamp bytes to packet counts and log once instead of aborting. */
+  static int warned_once = 0;
+  if (rb->txpdu_pkts > rb->txpdu_bytes ||
+      rb->rxpdu_pkts > rb->rxpdu_bytes ||
+      rb->txsdu_pkts > rb->txsdu_bytes ||
+      rb->rxsdu_pkts > rb->rxsdu_bytes) {
+    if (!warned_once) {
+      fprintf(stderr,
+              "[PDCP SM] Inconsistent counters detected (pkts > bytes). "
+              "Clamping bytes to packet counts to avoid process abort.\n");
+      warned_once = 1;
+    }
+    if (rb->txpdu_pkts > rb->txpdu_bytes) rb->txpdu_bytes = rb->txpdu_pkts;
+    if (rb->rxpdu_pkts > rb->rxpdu_bytes) rb->rxpdu_bytes = rb->rxpdu_pkts;
+    if (rb->txsdu_pkts > rb->txsdu_bytes) rb->txsdu_bytes = rb->txsdu_pkts;
+    if (rb->rxsdu_pkts > rb->rxsdu_bytes) rb->rxsdu_bytes = rb->rxsdu_pkts;
+  }
 
   return true;
 }
